# Copy to .env in the repository root. Never put these in VITE_* variables.
# Without a key the deterministic, explicitly offline mock provider is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: absolute directory or path relative to repository root.
DATA_DIR=./data
# Server always binds to 127.0.0.1; the default frontend proxy expects 4318.
PORT=4318

# Future adapters: metadata/configuration status only; not implemented and never called.
# Keep ALL keys server-side; there is deliberately no browser credential setter.
OPENROUTER_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
CUSTOM_OPENAI_API_KEY=
