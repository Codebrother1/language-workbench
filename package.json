{
  "name": "language-workbench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @workbench/server dev\" \"pnpm --filter @workbench/web dev\"",
    "build": "pnpm --filter @workbench/web build && pnpm --filter @workbench/server build",
    "start": "pnpm --filter @workbench/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:production": "node tests/production-smoke.mjs",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{ts,json,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
